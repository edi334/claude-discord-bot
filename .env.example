# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Your Discord user ID (enable Developer Mode, right-click your name, Copy User ID)
OWNER_DISCORD_ID=

# ID of the #claude text channel the bot will accept commands in
# (enable Developer Mode, right-click the channel, Copy Channel ID)
CLAUDE_CHANNEL_ID=

# Fixed folder Claude Code is allowed to operate in (absolute path)
CLAUDE_WORKDIR=C:\Users\you\Projects\your-project

# Optional: full path to claude.exe if it's not on PATH
# CLAUDE_BIN=C:\Users\you\AppData\Roaming\npm\claude.cmd

# Optional: kill Claude if a single request runs longer than this (seconds)
CLAUDE_TIMEOUT_SECONDS=600

# Optional: cap on agentic turns per request
CLAUDE_MAX_TURNS=15

# Optional: how long the Run/Cancel confirmation button waits before
# auto-cancelling a "full" (Bash) request, in seconds
CLAUDE_CONFIRM_TIMEOUT_SECONDS=60

# Optional: authenticate Claude Code via API key instead of an interactive
# `claude` login. Simplest option for a service account (e.g. claudebot) on
# a server. Get a key from https://console.anthropic.com/ — leave unset if
# you already logged in interactively as this account.
# ANTHROPIC_API_KEY=
