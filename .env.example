# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Your Discord user ID (enable Developer Mode, right-click your name, Copy User ID)
OWNER_DISCORD_ID=

# ID of the #claude text channel the bot will accept commands in
# (enable Developer Mode, right-click the channel, Copy Channel ID)
CLAUDE_CHANNEL_ID=

# Fixed folder Claude Code is allowed to operate in (absolute path)
CLAUDE_WORKDIR=C:\Users\you\Projects\your-project

# Optional: full path to claude.exe if it's not on PATH
# CLAUDE_BIN=C:\Users\you\AppData\Roaming\npm\claude.cmd

# Optional: kill Claude if a single request runs longer than this (seconds)
CLAUDE_TIMEOUT_SECONDS=600

# Optional: cap on agentic turns per request
CLAUDE_MAX_TURNS=15

# Optional: how long the Run/Cancel confirmation button waits before
# auto-cancelling a "full" (Bash) request, in seconds
CLAUDE_CONFIRM_TIMEOUT_SECONDS=60

# Authenticate Claude Code using your existing claude.ai subscription
# (Pro/Max/Team), instead of a separately-billed API key. Generate this
# ONCE on any machine with a browser (your laptop is fine, doesn't need to
# be the server or the bot's account) by running:
#   claude setup-token
# It prints a token valid for one year. Do NOT pass --bare to `claude` when
# using this — bare mode ignores CLAUDE_CODE_OAUTH_TOKEN and requires an
# API key instead. This bot doesn't use --bare, so it's compatible.
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative to the above: authenticate via a separately-billed API key
# instead of your subscription. Get one from https://console.anthropic.com/.
# Only set one of CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY, not both.
# ANTHROPIC_API_KEY=

# Date the token above expires, in YYYY-MM-DD format. `claude setup-token`
# tokens are valid for one year — set this to today's date plus one year.
# PowerShell to compute it: (Get-Date).AddYears(1).ToString('yyyy-MM-dd')
# The bot posts a warning in #claude at 30/14/7/3/1/0 days before this date
# (and daily if it's overdue), and /claude-status shows it on demand. Leave
# blank to disable the expiry check entirely (not recommended).
CLAUDE_TOKEN_EXPIRES_ON=

# Optional: comma-separated days-before-expiry to post a warning at.
# CLAUDE_TOKEN_WARN_DAYS=30,14,7,3,1,0
